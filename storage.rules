rules_version = '2';
// 관리자 이메일은 firebase-config.js 의 ADMIN_EMAILS 와 똑같이 맞춰 주세요.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.token.email in ['pol082753@gmail.com']; }
    match /uploads/{uid}/{fileId} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid && request.resource.size < 20 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
