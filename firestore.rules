rules_version = '2';
// 관리자 이메일은 firebase-config.js 의 ADMIN_EMAILS 와 똑같이 맞춰 주세요.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email in ['pol082753@gmail.com']; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    // 학생 개인 기록: 본인만 쓰고, 본인과 관리자만 읽어요.
    match /data/users/{uid}/{rest=**} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isMe(uid);
    }
    // 학생 요약(관리자 학생 목록용)
    match /roster/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow write: if isMe(uid);
    }
    // 국어·영어 진도: 관리자만 쓰고, 학생은 자기 것만 읽어요.
    match /progress/{sid} {
      allow read: if isMe(sid) || isAdmin();
      allow write: if isAdmin();
      match /items/{id} {
        allow read: if isMe(sid) || isAdmin();
        allow write: if isAdmin();
      }
    }
    // 안내 방송 문구, 앱 이름 아래 문구: 누구나 읽고 관리자만 바꿔요.
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
